# New Relic Configuration
# API Key for creating dashboard deeplinks
# Set this to your New Relic user API key (NRAK-...)
NR_API_KEY=

# Optional: New Relic environment ("us" or "eu", default: "us")
# NR_ENV=us

# Optional: Backend server port (default: 3000)
# PORT=3000

# Optional: Site root for serving demo pages
# SITE_ROOT=

# Optional: Allowed origins for CORS (comma-separated)
# ALLOWED_ORIGINS=https://example.com,http://localhost:8080

# Optional: Fault window for downstream-culprit exercise (default: 15 minutes)
# FAULT_WINDOW_MINUTES=15

# Optional: Payment service latency during fault window (default: 700ms)
# PAYMENT_SLOW_MS=700

# Optional: Payment service error rate during fault window (default: 0.25)
# PAYMENT_ERROR_RATE=0.25

# Optional: Bad deploy exercise window start minute (default: 30)
# BAD_DEPLOY_WINDOW_START=30

# Optional: Bad deploy exercise window duration (default: 15 minutes)
# BAD_DEPLOY_WINDOW_MINUTES=15

# Optional: Bad deploy exercise error rate (default: 0.5)
# BAD_DEPLOY_ERROR_RATE=0.5
