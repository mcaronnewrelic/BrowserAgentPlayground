          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "## Your events\nThree ways to record “something happened”: `PageAction` (addPageAction), `DemoAction` (recordCustomEvent) and `BrowserInteraction` (SPA). One query spans all three with `eventType()`."
          }
        },
        {
          "title": "Your events by type",
          "layout": {
            "column": 1,
            "row": 3,
            "width": 12,
            "height": 4
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT count(*) FROM PageAction, DemoAction, BrowserInteraction WHERE demoCode = {{demoCode}} FACET eventType() SINCE 1 week ago"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Measures",
      "description": null,
      "widgets": [
        {
          "title": null,
          "layout": {
            "column": 1,
            "row": 1,
            "width": 12,
            "height": 2
          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "## Your measures\nYour custom timings from `performance.measure()` / `newrelic.measure()` land as `BrowserPerformance` events. They only appear once you create them on the Measures page; `name` is your measure's label."
          }
        },
        {
          "title": "Your measures",
          "layout": {
            "column": 1,
            "row": 3,
            "width": 12,
            "height": 4
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT count(*) AS 'Count', average(duration) AS 'Avg duration (ms)', max(duration) AS 'Max (ms)' FROM BrowserPerformance WHERE demoCode = {{demoCode}} FACET name SINCE 1 week ago LIMIT 20"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Tracing",
