{
  "name": "Agent Playground My Session",
  "description": "One learner's own telemetry across the whole learning path, filtered by a demoCode session-code variable, plus a cohort-wide NRQL Level-Up page of worked query examples. Simulated visitors (SIM- codes) are left out of the picker.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "My Session",
      "description": null,
      "widgets": [
        {
          "title": null,
          "layout": {
            "column": 1,
            "row": 1,
            "width": 12,
            "height": 2
          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "## Your session\nPick or type your **session code** in the `demoCode` variable at the top (it's in the header of every demo page). Every page of this dashboard then shows only your own data. Simulated visitors (`SIM-` codes) are left out of the picker."
          }
        },
        {
          "title": "You",
          "layout": {
            "column": 1,
            "row": 3,
            "width": 3,
            "height": 2
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT latest(demoUser) AS 'You' FROM PageView WHERE demoCode = {{demoCode}} SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Pages visited",
          "layout": {
            "column": 4,
            "row": 3,
            "width": 3,
            "height": 2
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT uniqueCount(pageUrl) AS 'Pages visited' FROM PageView WHERE demoCode = {{demoCode}} SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Quiz answers",
          "layout": {
            "column": 7,
            "row": 3,
            "width": 3,
            "height": 2
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT count(*) AS 'Quiz answers' FROM DemoQuizAnswer WHERE demoCode = {{demoCode}} SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Right first try",
          "layout": {
            "column": 10,
            "row": 3,
            "width": 3,
            "height": 2
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT percentage(count(*), WHERE outcome = 'correct') AS 'Right first try' FROM DemoQuizAnswer WHERE attempt = 1 AND demoCode = {{demoCode}} SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Your progress through the path",
          "layout": {
            "column": 1,
            "row": 5,
            "width": 12,
            "height": 4
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT count(*) AS 'Page views' FROM PageView WHERE demoCode = {{demoCode}} FACET CASES (WHERE pageUrl LIKE '%/install.html' AS '1 · Install', WHERE pageUrl LIKE '%/vitals.html' AS '2 · Vitals', WHERE pageUrl LIKE '%/errors.html' AS '3 · Errors', WHERE pageUrl LIKE '%/frustration.html' AS '4 · Frustration', WHERE pageUrl LIKE '%/logs.html' AS '5 · Logs', WHERE pageUrl LIKE '%/events.html' AS '6 · Events', WHERE pageUrl LIKE '%/measures.html' AS '7 · Measures', WHERE pageUrl LIKE '%/tracing.html' AS '8 · Tracing', WHERE pageUrl LIKE '%/websockets.html' AS '9 · WebSockets', WHERE pageUrl LIKE '%/spa.html' AS '10 · SPA', WHERE pageUrl LIKE '%/replay.html' AS '11 · Replay') SINCE 1 week ago"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Vitals",
      "description": null,
      "widgets": [
        {
          "title": null,
          "layout": {
            "column": 1,
            "row": 1,
            "width": 12,
            "height": 2
          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "## Your Core Web Vitals\nThe percentiles of your own page loads, and the distribution behind them. p75 is the threshold Google judges a page by."
          }
        },
        {
          "title": "Your vitals (percentiles)",
          "layout": {
            "column": 1,
            "row": 3,
            "width": 5,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT percentile(largestContentfulPaint, 50, 75, 95) AS 'LCP (s)', percentile(cumulativeLayoutShift, 75) AS 'CLS p75', percentile(interactionToNextPaint, 75) AS 'INP p75 (s)' FROM PageViewTiming WHERE demoCode = {{demoCode}} SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "Your LCP distribution",
          "layout": {
            "column": 6,
            "row": 3,
            "width": 7,
            "height": 3
          },
          "visualization": {
            "id": "viz.histogram"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT histogram(largestContentfulPaint, 4, 20) FROM PageViewTiming WHERE demoCode = {{demoCode}} SINCE 1 week ago"
              }
            ]
          }
        }
      ]
    },
    {
