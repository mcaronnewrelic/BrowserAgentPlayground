    {
      "name": "NRQL Level-Up",
      "description": null,
      "widgets": [
        {
          "title": null,
          "layout": {
            "column": 1,
            "row": 1,
            "width": 12,
            "height": 2
          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "## NRQL Level-Up\nCohort-wide worked examples — techniques beyond what the other dashboards use, each run against this site's own data. Read the title, then the query."
          }
        },
        {
          "title": "1 · percentile() + spread",
          "layout": {
            "column": 1,
            "row": 3,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT percentile(largestContentfulPaint, 50, 75, 95, 99) FROM PageViewTiming WHERE largestContentfulPaint IS NOT NULL TIMESERIES AUTO SINCE 1 day ago"
              }
            ]
          }
        },
        {
          "title": "2 · histogram() — the distribution",
          "layout": {
            "column": 7,
            "row": 3,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.histogram"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT histogram(largestContentfulPaint, 4, 20) FROM PageViewTiming WHERE largestContentfulPaint IS NOT NULL SINCE 1 day ago"
              }
            ]
          }
        },
        {
          "title": "3 · FACET CASES — rating buckets",
          "layout": {
            "column": 1,
            "row": 6,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT count(*) FROM PageViewTiming WHERE largestContentfulPaint IS NOT NULL FACET CASES (WHERE largestContentfulPaint <= 2.5 AS 'Good', WHERE largestContentfulPaint <= 4 AS 'Needs work', WHERE largestContentfulPaint > 4 AS 'Poor') SINCE 1 day ago"
              }
            ]
          }
        },
        {
          "title": "4 · COMPARE WITH — this week vs last",
          "layout": {
            "column": 7,
            "row": 6,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT count(*) FROM PageView WHERE appId = 1117825756 TIMESERIES AUTO COMPARE WITH 1 week ago SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "5 · multi-event union + eventType()",
          "layout": {
            "column": 1,
            "row": 9,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT count(*) FROM PageView, JavaScriptError, Log, PageAction WHERE demoCode IS NOT NULL FACET eventType() TIMESERIES AUTO SINCE 1 day ago"
              }
            ]
          }
        },
        {
          "title": "6 · filter() — % wrong by page",
          "layout": {
            "column": 7,
            "row": 9,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT filter(count(*), WHERE outcome = 'incorrect') / count(*) * 100 AS '% wrong' FROM DemoQuizAnswer FACET demoPage SINCE 1 week ago"
              }
            ]
          }
        },
        {
          "title": "7 · rate() — counts to rates",
          "layout": {
            "column": 1,
            "row": 12,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT rate(count(*), 1 minute) AS 'Answers/min' FROM DemoQuizAnswer TIMESERIES AUTO SINCE 1 day ago"
              }
            ]
          }
        },
        {
          "title": "8 · uniqueCount() vs count()",
          "layout": {
            "column": 7,
            "row": 12,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT count(*) AS 'Page views', uniqueCount(session) AS 'Sessions', uniqueCount(demoCode) AS 'Codes' FROM PageView WHERE appId = 1117825756 SINCE 1 day ago"
              }
            ]
          }
        },
        {
          "title": "9 · keyset() — what attributes exist",
          "layout": {
            "column": 1,
            "row": 15,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT keyset() FROM DemoQuizAnswer SINCE 1 day ago"
              }
            ]
          }
        },
        {
          "title": "10 · nested subquery — still wrong",
          "layout": {
            "column": 7,
            "row": 15,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6932347
                ],
                "query": "SELECT count(*) AS 'Still-wrong (code,question) pairs' FROM (SELECT latest(outcome) AS outcome FROM DemoQuizAnswer FACET demoCode, question LIMIT MAX) WHERE outcome = 'incorrect' SINCE 1 week ago"
              }
            ]
          }
        }
      ]
    }
  ],
  "variables": [
    {
      "name": "demoCode",
      "items": null,
      "defaultValues": [],
      "nrqlQuery": {
        "accountIds": [
          6932347
        ],
        "query": "SELECT uniques(demoCode) FROM DemoQuizAnswer WHERE demoCode NOT LIKE 'SIM-%' SINCE 1 week ago"
      },
      "options": {
        "hiddenOnVariablesBar": false,
        "ignoreTimeRange": true,
