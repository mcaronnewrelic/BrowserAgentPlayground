            "height": 2
          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "## Your traces\nAJAX requests from your pages, by response code, and the backend transactions they reached (the agent joins them into one distributed trace)."
