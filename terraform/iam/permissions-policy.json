{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStatePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::brosweragentplayground-terraform-state",
      "Condition": {
        "StringLike": { "s3:prefix": ["agent-playground/*"] }
      }
    },
    {
      "Sid": "ReadWriteStateAndLock",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::brosweragentplayground-terraform-state/agent-playground/*"
    }
  ]
}
